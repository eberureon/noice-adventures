{
  "name": "noice-adventures",
  "version": "1.0.0",
  "description": "Small arcade game which was made in the course of a school project. In corporation with @alexwe1ss.",
  "main": "main.js",
  "scripts": {
    "build:ts": "tsc",
    "build:watch": "tsc --watch",
    "prebuild": "npm run build:ts",
    "prestart": "npm run build:ts",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build:all": "electron-builder -mwl --x64",
    "build:win": "electron-builder -w --publish=never",
    "build:mac": "electron-builder -m --publish=never",
    "build:linux": "electron-builder -l --publish=never"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "phaser-ce": "^2.21.0",
    "typescript": "^7.0.2"
  },
  "author": "Alexander Weiß, Leon Ebel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebelleon/noice-adventures"
  },
  "license": "ISC"
}
