{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "lib": ["ES2017", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "declaration": false,
    "sourceMap": true,
    "removeComments": false,
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": ["src-ts/**/*", "types/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
